GROQ_API_KEY=

# Postgres connection string, e.g. postgres://user:pass@postgres:5432/hzla
DATABASE_URL=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required for Auth.js v5 when self-hosting behind a reverse proxy/tunnel (not Vercel)
AUTH_TRUST_HOST=true

# Public URL of the site, e.g. https://hzla.example.com
AUTH_URL=

# Resend (resend.com) — used to email login 2FA codes
RESEND_API_KEY=
RESEND_FROM_EMAIL=HZLA <noreply@hzla.uk>

# Google OAuth ("Continue with Google") — create at console.cloud.google.com,
# authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
